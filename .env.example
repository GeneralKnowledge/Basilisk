# FreeLLMAPI (OpenAI-compatible gateway)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=freellmapi-your-unified-key
FREELLMAPI_MODEL=auto

# auto | freellmapi | mock
ENTITY_INFERENCE=auto

# Tick interval in seconds
ENTITY_TICK_SECONDS=8

# Aquarium overlay (bind local for OBS or headless capture)
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8787
AQUARIUM_URL=http://127.0.0.1:8787/

# Headless streaming via Playwright + ffmpeg (no desktop/OBS required)
# Prefer this on a server. Keep STREAM_KEY out of git and public chat.
STREAM_OUTPUT=rtmp
STREAM_RTMP_URL=rtmp://live.twitch.tv/app
STREAM_KEY=
STREAM_FPS=5
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_VIDEO_BITRATE=2500k
STREAM_FILE=data/stream_preview.mp4
# FFMPEG_BIN=ffmpeg
